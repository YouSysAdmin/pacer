# Build artifacts
bin/
build/

# Node deps. The SPA lives in frontend/ and has its own ignore file,
# but running a bun/vitest command from the repo root drops a cache
# here -- which is how node_modules/.vite/vitest/results.json once got
# committed. Unanchored so it matches at any depth.
node_modules/
.vite/

# SQLite (dev DB + WAL/SHM sidecars)
*.db
*.db-shm
*.db-wal

# TLS / signing material — never commit
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# Env / dotfiles with secrets
.env
.env.*
!.env.example

# Operator-supplied production config (examples/ contains the templates)
pacer.yaml
aws-github-runner.yaml

# Hugo
docs/public/
docs/resources/

# Logs / coverage / temp
*.log
*.out
coverage.txt
profile.cov

# Editor / OS
.DS_Store
.idea/

# UI kit
ui-kit/
