{
  "name": "pacer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 SPA for Pacer. Built with Vite and embedded into the Go binary via //go:embed.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check src",
    "lint:fix": "eslint . --fix && prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.25",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.2.0"
  }
}
