{
  "name": "pacer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Svelte frontend for Pacer. Prerenders to static via @sveltejs/adapter-static and is embedded into the Go binary via //go:embed.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run minify:html",
    "minify:html": "bun scripts/minify-html.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^25",
    "svelte": "^5.20.0",
    "vite": "^6.0.0",
    "vitest": "^2"
  }
}
